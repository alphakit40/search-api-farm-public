# search-api-farm secrets — copy to `secrets.env` and fill in.
# `secrets.env` is gitignored; never commit real values.
# Every script reads these via secrets_env.py (req/opt/key_list/brd_cdp).

# --- GitHub (push tooling) ---------------------------------------------------
GH_PAT=
GH_REPO=owner/search-api-farm-public

# --- BrightData Scraping Browser (solves Cloudflare Turnstile server-side) ---
BRD_CUSTOMER=
BRD_ZONE_MCP_BROWSER=
BRD_ZONE_ISP_PROXY1=
BRD_ZONE_ISP_PROXY2=
BRD_ZONE_MCP_UNLOCKER=
BRD_ZONE_DATACENTER_PROXY1=

# --- CAPTCHA solvers ---------------------------------------------------------
YESCAPTCHA_KEY=
TW…KEY=

# --- Email pool for signup / magic-link / OTP (email:password per line) ------
IMAP_POOL=C:/path/to/imap.txt
# mailbox used by reggers/firecrawl_magic.py to RESUME an existing Firecrawl signup
FIRECRAWL_EMAIL=

# --- Harvested search-API keys (comma-separated where multiple) --------------
EXA_KEYS=
TAVILY_KEY=
SERPWRAP_KEY=
YOU_KEY=
FIRECRAWL_KEY=
JINA_KEY=

# --- Optional / blocked targets ---------------------------------------------
SEARCHAPI_KEY=
SERPAPI_KEY=
